{
  "name": "@thed24/pi-ui",
  "version": "0.16.2",
  "description": "Web UI for the pi coding agent — runs in your browser, served from a Raspberry Pi or any Bun-capable machine.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/dominic-codespoti/pi-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominic-codespoti/pi-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dominic-codespoti/pi-ui/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "pwa",
    "bun",
    "svelte"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pi-ui": "./bin/pifrontier"
  },
  "files": [
    "bin/",
    "build/",
    "!build/**/*.map",
    "scripts/",
    "src/lib/auth/password.ts",
    "src/lib/auth/rate-limiter.ts",
    "src/lib/markdown.ts",
    "src/lib/tui-stubs.ts",
    "src/lib/ws/protocol.ts",
    "server.ts",
    "server.bundle.js"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:ws": "PI_UI_JWT_SECRET=dev-ws-only-secret HOST=127.0.0.1 PORT=5174 DEV_WS_ONLY=true bun --watch server.ts",
    "dev:full": "bun scripts/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:sw": "tsc --noEmit -p src/service-worker/tsconfig.json",
    "check:server": "tsc --noEmit --project tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "bun --smol run bin/pifrontier.ts",
    "build:server": "bun build ./server.ts --target bun --outfile ./server.bundle.js --minify --external './build/handler.js' --external '@earendil-works/pi-coding-agent' --external '@earendil-works/pi-ai'",
    "test": "bun test src/lib/auth --timeout 15000",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test && playwright test -c playwright.live.config.ts",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:ci": "bun run check && bun run check:sw && bun run check:server && bun run lint && bun run test:unit && bun run test:e2e",
    "prepublishOnly": "bun run build && bun run build:server"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "valibot": "^1.4.2",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "protobufjs": "7.6.5",
    "vite": "8.2.2",
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.37.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/kit": "3.0.0-next.23",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.4.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.22",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-adapter-bun": "file:./adapters/svelte-adapter-bun",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
