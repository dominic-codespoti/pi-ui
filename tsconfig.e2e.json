{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts",
    "playwright.live.config.ts",
    "src/app.d.ts",
    ".svelte-kit/types/**/*.d.ts"
  ],
  "exclude": ["node_modules/**", "build/**"]
}
