PI_PASSWORD=replace-with-a-long-random-password
# PORT=3000                     # Override the default port
# HOST=127.0.0.1                # Bind address (default 127.0.0.1 — set to 0.0.0.0 ONLY
#                               # for deliberate remote access behind TLS)
# PI_CWD=/home/pi/projects/my-project  # Default working directory
# PI_UI_PACKAGE_MANAGER=bun     # Override package manager detection (bun/npm/pnpm/yarn)
# PI_UI_UPDATE_COMMAND=         # Custom shell command for pi-ui updates
# PI_UI_JWT_SECRET=             # Shared session-token signing secret (≥32 chars) for
#                               # multi-process deployments; default is a random
#                               # per-process secret (restart = global sign-out)
